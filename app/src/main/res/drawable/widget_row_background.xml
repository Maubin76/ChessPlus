<?xml version="1.0" encoding="utf-8"?>
<!-- Zone touchable du puzzle du jour dans le widget : retour visuel du système. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_line">
	<item android:id="@android:id/mask">
		<shape android:shape="rectangle">
			<solid android:color="@color/widget_line" />
			<corners android:radius="6dp" />
		</shape>
	</item>
</ripple>
